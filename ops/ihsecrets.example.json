{
  "files": {
    "jbase/globals.db": {
      "type": "nedb",
      "rules": [
        {"match": {"dn": "example_secret"}, "field": "defval", "env": "EXAMPLE_SECRET"}
      ]
    },
    "jbase/units.db": {
      "type": "nedb",
      "auto_fields": ["password", "pass", "pwd", "ppw", "token", "ya_oauth_client_secret", "ya_oauth_user_token", "sshkey"]
    },
    "project.json": {
      "type": "json",
      "rules": [{"field": "lat", "env": "PROJECT_LAT"}, {"field": "lng", "env": "PROJECT_LNG"}]
    }
  }
}
